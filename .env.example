# LoopSight v2 — Environment Configuration Template
# Copy to .env for local development. Never commit real secrets (.env is gitignored).
# Architecture target: AWS Lambda ARM64. Actual account pricing and deployment need verification.
# Deliberately not pursuing Best Use of COOL (requires paid Marketplace AMI + m8g.4xlarge).

# 1. Bounded Agent (Gemini API) — Optional
# Leave empty to use the deterministic active-perception policy (_fixture_for_first_pass).
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.6-flash
GEMINI_TIMEOUT_SECONDS=15

# 2. Persistence & Storage — Optional
# When DYNAMO_TABLE_NAME is set and AWS credentials resolve, DynamoJobStore is used.
# Otherwise InMemoryJobStore with SQLite write-through (LOOPSIGHT_SQLITE_PATH) is used.
DYNAMO_TABLE_NAME=
LOOPSIGHT_SQLITE_PATH=/tmp/loopsight_jobs.sqlite3
# Capture sessions survive workers sharing this file. Separate Lambda instances
# do not share /tmp: a shared cloud session/evidence store is still required.
LOOPSIGHT_CAPTURE_DB_PATH=/tmp/loopsight_jobs.sqlite3
LOOPSIGHT_CAPTURE_TTL_SECONDS=1800

# 3. CORS & Network Hardening
# Comma-separated allowed origins or * for public judge access
CORS_ORIGINS=*

# 4. Demo & Evaluation Controls
# Set DEMO_MODE=golden only when serving static golden fixtures instead of live OpenCV
DEMO_MODE=
DEMO_CASE=
FORCE_AMBIGUOUS=0
FAIL_CLOSED_PROD=0

# 5. Frontend Proxy Target (used by apps/web)
INFERENCE_API_URL=http://localhost:8000
