# LoopSight Lambda packaging. Deployment and account costs require verification.
FROM public.ecr.aws/lambda/python:3.13-arm64

# Lambda's work dir — all code must be in ${LAMBDA_TASK_ROOT} (/var/task)
WORKDIR ${LAMBDA_TASK_ROOT}

# Install Python deps into the Lambda task root.
# Build context is the repository root (see README_DEPLOY_LAMBDA.md), so requirements.txt is at the root.
COPY requirements.txt ${LAMBDA_TASK_ROOT}/requirements.txt
RUN pip install --no-cache-dir --upgrade pip && \
    pip install --no-cache-dir -r ${LAMBDA_TASK_ROOT}/requirements.txt

# Copy the inference service. When building from the repo root, these are under services/inference/.
# If you prefer building with context = services/inference, copy requirements.txt into that dir first
# or adjust the COPY source paths accordingly.
COPY services/inference/cv ${LAMBDA_TASK_ROOT}/cv
COPY services/inference/agent ${LAMBDA_TASK_ROOT}/agent
COPY services/inference/storage.py ${LAMBDA_TASK_ROOT}/storage.py
COPY services/inference/demo_golden.py ${LAMBDA_TASK_ROOT}/demo_golden.py
COPY services/inference/evidence.py ${LAMBDA_TASK_ROOT}/evidence.py
COPY services/inference/capture_sessions.py ${LAMBDA_TASK_ROOT}/capture_sessions.py
COPY services/inference/cloud_storage.py ${LAMBDA_TASK_ROOT}/cloud_storage.py
COPY services/inference/request_limits.py ${LAMBDA_TASK_ROOT}/request_limits.py
COPY services/inference/evidence_bundle.py ${LAMBDA_TASK_ROOT}/evidence_bundle.py
COPY services/inference/sample_frames.py ${LAMBDA_TASK_ROOT}/sample_frames.py
COPY services/inference/main.py ${LAMBDA_TASK_ROOT}/main.py

# The handler that Mangum exposes: main.handler wraps the FastAPI app.
CMD ["main.handler"]
