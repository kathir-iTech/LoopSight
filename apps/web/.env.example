# LoopSight web — copy to .env.local and fill as needed (see root .env.example for full list)
# The Next.js proxy forwards /api/inspect and /api/jobs/[id] to this URL.
# Local default is http://localhost:8000 (uvicorn main:app). After Lambda deploy, set to Function URL:
# e.g. https://abc123.lambda-url.us-east-1.on.aws
INFERENCE_API_URL=http://localhost:8000
# Optional demo resilience (see services/inference/demo_golden.py):
# DEMO_MODE=golden
# DEMO_CASE=uncertain
# FORCE_AMBIGUOUS=1
